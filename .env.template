# ============================================
# PHOENIX BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy these variables from Railway Dashboard:
# https://railway.app/project/YOUR_PROJECT/settings/variables
#
# Then rename this file to .env
# ============================================

# ==================== DATABASE ====================
MONGODB_URI=

# ==================== FILE STORAGE ====================
UPLOAD_DIR=./uploads

# ==================== AI SERVICES ====================
# Gemini API (Primary - 95% cheaper than OpenAI)
GEMINI_API_KEY=

# OpenAI (Fallback + TTS)
OPENAI_API_KEY=

# Google AI (Alternative)
GOOGLE_AI_API_KEY=

# ==================== TWILIO (SMS + CALLS) ====================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ==================== PLAID (BANKING) ====================
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ==================== STRIPE (PAYMENTS) ====================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ==================== OAUTH PROVIDERS ====================
# Fitbit
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Oura Ring
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Google (Calendar, etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook (Calendar)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ==================== APP CONFIGURATION ====================
JWT_SECRET=
JWT_EXPIRE=7d
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8000
NODE_ENV=development
PORT=5002

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:8000,http://localhost:3000

# ==================== OPTIONAL ====================
# Uber (OAuth - if using API method)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Lyft (OAuth - if using API method)
LYFT_CLIENT_ID=
LYFT_CLIENT_SECRET=

# ==================== PIPER TTS ====================
PIPER_TTS_URL=http://localhost:5001
